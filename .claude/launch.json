{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@repo/native",
        "web"
      ],
      "port": 8081,
      "autoPort": true
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@repo/web",
        "dev"
      ],
      "port": 3000
    }
  ]
}
