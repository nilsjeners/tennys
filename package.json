{
  "name": "tennys",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "start": "pnpm --filter @repo/native start",
    "web": "pnpm --filter @repo/native web",
    "ios": "pnpm --filter @repo/native ios",
    "android": "pnpm --filter @repo/native android",
    "convex:dev": "pnpm --filter @repo/backend dev"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
